# Closed beta only. Do not use local checkpoint syncers after public launch.
# XGR chain metadata is loaded from xgrchain.json. Base metadata and its RPC pool
# come from the pinned Hyperlane 2.3.0 agent config; only the signer is overridden.
CONFIG_FILES=/config/xgrchain.json
HYP_LOG_FORMAT=json
HYP_LOG_LEVEL=info
HYP_METRICSPORT=9090
HYP_DB=/data/relayer
HYP_RELAYCHAINS=xgrchain,base
HYP_GASPAYMENTENFORCEMENT=[{"type":"none"}]
HYP_IGPINDEXINGENABLED=false
HYP_ALLOWLOCALCHECKPOINTSYNCERS=true

HYP_CHAINS_XGRCHAIN_SIGNER_KEY=REPLACE_WITH_SECRET_RELAYER_KEY
HYP_CHAINS_BASE_SIGNER_KEY=REPLACE_WITH_SECRET_RELAYER_KEY
