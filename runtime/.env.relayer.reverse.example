# Base -> XGR native interchain relayer.
# The relayer is untrusted; this private key pays XGR destination gas only.
RELAYER_KEY_ACCOUNT=xgr-base-deployer

# XGR nodes expose the completed native validator attestation.
ATTESTATION_RPC_URL=https://rpc.xgr.network
ATTESTATION_CHAIN_ID=1643
ATTESTATION_ROUTE=base_to_xgr
ATTESTATION_SIGNATURE_FORMAT=compressed

# Hyperlane message/checkpoint origin: Base.
ORIGIN_RPC_URL=https://base-rpc.publicnode.com
ORIGIN_CHAIN_ID=8453
ORIGIN_DOMAIN=8453
ORIGIN_MAILBOX=0xeA87ae93Fa0019a82A727bfd3eBd1cFCa8f64f1D
ORIGIN_MERKLE_TREE_HOOK=0x19dc38aeae620380430C200a6E990D5Af5480117

# Set this immediately before first start to Base head + 1.
# A fresh relayer snapshots MerkleTreeHook.tree() at ORIGIN_START_BLOCK - 1.
ORIGIN_START_BLOCK=REPLACE_WITH_BASE_HEAD_PLUS_ONE
ORIGIN_CONFIRMATIONS=12
ORIGIN_LOG_CHUNK=2000

# Hyperlane process destination: XGRChain.
DESTINATION_RPC_URL=https://rpc.xgr.network
DESTINATION_CHAIN_ID=1643
DESTINATION_DOMAIN=1643
DESTINATION_MAILBOX=0x5632409bc2f0e8bAc4AaF43654D4FFc7822C9c79

# XGR recipient routes Base-origin messages through a 2-of-2 aggregation ISM:
# module 0 = PausableISM (present with empty metadata)
# module 1 = XGRNativeInterchainISMV2 (receives the BLS/Merkle metadata)
DESTINATION_AGGREGATION_MODULE_COUNT=2
DESTINATION_AGGREGATION_INNER_INDEX=1
DESTINATION_AGGREGATION_EMPTY_INDEXES=0

POLL_INTERVAL_MS=3000
RELAYER_SUBMIT=false
RELAYER_COMPACT_AFTER_LEAVES=10000
RELAYER_STATE_PATH=runtime-state/native-relayer-reverse-state.json
