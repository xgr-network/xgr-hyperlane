# Canonical native XGR -> Base production relayer configuration.
# The gas key is loaded interactively from the existing Foundry keystore.
RELAYER_KEY_ACCOUNT=xgr-base-deployer

XGR_RPC_URL=http://127.0.0.1:8545
XGR_CHAIN_ID=1643
XGR_DOMAIN=1643
XGR_MAILBOX=0x5632409bc2f0e8bAc4AaF43654D4FFc7822C9c79
XGR_MERKLE_TREE_HOOK=0xeD98Af715b5a72dCD412567eb086d48225CDDACF
XGR_ATTESTATION_DESTINATION=base
ATTESTATION_SIGNATURE_FORMAT=eip2537
XGR_START_BLOCK=0
XGR_CONFIRMATIONS=1
XGR_LOG_CHUNK=500

DESTINATION_RPC_URL=https://base-rpc.publicnode.com
DESTINATION_CHAIN_ID=8453
DESTINATION_DOMAIN=8453
DESTINATION_MAILBOX=0xeA87ae93Fa0019a82A727bfd3eBd1cFCa8f64f1D

POLL_INTERVAL_MS=3000
RELAYER_SUBMIT=true
RELAYER_STATE_PATH=runtime-state/native-relayer-state.json
