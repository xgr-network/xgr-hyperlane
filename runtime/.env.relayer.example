# XGR 3.0 native interchain relayer.
# This key pays destination gas only. It has no authority in the XGR security model.
RELAYER_PRIVATE_KEY=REPLACE_WITH_DESTINATION_GAS_KEY

XGR_RPC_URL=https://rpc.xgr.network
XGR_CHAIN_ID=1643
XGR_DOMAIN=1643
XGR_MAILBOX=0x5632409bc2f0e8bAc4AaF43654D4FFc7822C9c79
XGR_MERKLE_TREE_HOOK=0xeD98Af715b5a72dCD412567eb086d48225CDDACF
XGR_ATTESTATION_DESTINATION=base
XGR_START_BLOCK=0
XGR_CONFIRMATIONS=1
XGR_LOG_CHUNK=2000

DESTINATION_RPC_URL=https://base.publicnode.com
DESTINATION_CHAIN_ID=8453
DESTINATION_DOMAIN=8453
DESTINATION_MAILBOX=0xeA87ae93Fa0019a82A727bfd3eBd1cFCa8f64f1D

POLL_INTERVAL_MS=3000
RELAYER_STATE_PATH=/data/native-relayer-state.json
