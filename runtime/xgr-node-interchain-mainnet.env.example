# XGRChain v3.1.2 Interchain / ILN worker: Base spoke only.
# Non-secret reference values for /etc/xgrchain/node.conf.
#
# v3.1.2 security rule:
#   ENV selects networks and bootstrap registries.
#   Canonical route addresses / fees come from each source chain's ILN registry.
# Legacy route-local SOURCE_TYPE / SOURCE_CHAIN_ID / SOURCE_MAILBOX_ADDR /
# SOURCE_MERKLE_TREE_HOOK_ADDR fields are intentionally not used.

# Local XGR Hyperlane infrastructure retained by the node.
XGR_INTERCHAIN_ORIGIN_MAILBOX_ADDR=0x5632409bc2f0e8bAc4AaF43654D4FFc7822C9c79
XGR_INTERCHAIN_ORIGIN_MERKLE_TREE_HOOK_ADDR=0xeD98Af715b5a72dCD412567eb086d48225CDDACF

# ---------------------------------------------------------------------------
# Base network
# ---------------------------------------------------------------------------
XGR_INTERCHAIN_BASE_CHAIN_ID=8453
XGR_INTERCHAIN_BASE_DOMAIN=8453

# New v3.1.2 Base-destination RegistryV2. This replaces the V1 registry for
# ILN checkpoint-set reads after the controlled cutover.
XGR_INTERCHAIN_BASE_REGISTRY_ADDR=<BASE_DESTINATION_REGISTRY_V2>

# Base source-chain canonical ILN registry.
XGR_INTERCHAIN_BASE_ILN_REGISTRY_ADDR=<BASE_ILN_REGISTRY>

XGR_INTERCHAIN_BASE_RPC=https://base-rpc.publicnode.com

# Base-origin ILN operations require 12 confirmed Base blocks before signing.
# v3.1.2 uses the network-level confirmation policy for ILN source reads.
XGR_INTERCHAIN_BASE_CONFIRMATIONS=12

# Used for validator-set membership transitions on the Base RegistryV2.
XGR_INTERCHAIN_BASE_DEACTIVATION_RESERVE_WEI=<BASE_DEACTIVATION_RESERVE_WEI>
XGR_INTERCHAIN_BASE_MEMBERSHIP_VALIDITY_SECONDS=300
XGR_INTERCHAIN_BASE_EXECUTOR_STEP_DELAY_SECONDS=10
XGR_INTERCHAIN_BASE_VERIFIER_FORMAT=eip2537

# ---------------------------------------------------------------------------
# XGRChain network
# ---------------------------------------------------------------------------
XGR_INTERCHAIN_XGR_CHAIN_ID=1643
XGR_INTERCHAIN_XGR_DOMAIN=1643

# Existing XGR-destination RegistryV2 remains canonical.
XGR_INTERCHAIN_XGR_REGISTRY_ADDR=0x013F2F2f7dB897F941b19C4ab71C5395a48A0292

# New XGR source-chain canonical ILN registry.
XGR_INTERCHAIN_XGR_ILN_REGISTRY_ADDR=<XGR_ILN_REGISTRY>

XGR_INTERCHAIN_XGR_RPC=http://127.0.0.1:8545
XGR_INTERCHAIN_XGR_CONFIRMATIONS=1
XGR_INTERCHAIN_XGR_DEACTIVATION_RESERVE_WEI=1000000000000000000
XGR_INTERCHAIN_XGR_MEMBERSHIP_VALIDITY_SECONDS=300
XGR_INTERCHAIN_XGR_EXECUTOR_STEP_DELAY_SECONDS=10
XGR_INTERCHAIN_XGR_VERIFIER_FORMAT=compressed

# ---------------------------------------------------------------------------
# Explicit Base spoke routes
# ---------------------------------------------------------------------------
# XGRChain -> Base
XGR_INTERCHAIN_ROUTE_XGR_TO_BASE_SOURCE_NETWORK=xgr
XGR_INTERCHAIN_ROUTE_XGR_TO_BASE_DESTINATION=base

# Base -> XGRChain
XGR_INTERCHAIN_ROUTE_BASE_TO_XGR_SOURCE_NETWORK=base
XGR_INTERCHAIN_ROUTE_BASE_TO_XGR_DESTINATION=xgr
