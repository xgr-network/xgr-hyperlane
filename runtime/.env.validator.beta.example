# Closed beta only. Keep the XGRChain Base-origin PausableIsm paused.
# Numeric XGR chain metadata lives in xgrchain.json so Hyperlane 2.3.0 receives
# real JSON numbers instead of environment-variable strings.
CONFIG_FILES=/config/xgrchain.json
HYP_LOG_FORMAT=json
HYP_LOG_LEVEL=info
HYP_METRICSPORT=9094
HYP_DB=/data/validator
HYP_ORIGINCHAINNAME=xgrchain
HYP_INTERVAL=2

HYP_VALIDATOR_KEY=REPLACE_WITH_SECRET_VALIDATOR_KEY
HYP_CHAINS_XGRCHAIN_SIGNER_KEY=REPLACE_WITH_SECRET_VALIDATOR_KEY
HYP_CHECKPOINTSYNCER_TYPE=localStorage
HYP_CHECKPOINTSYNCER_PATH=/checkpoints
